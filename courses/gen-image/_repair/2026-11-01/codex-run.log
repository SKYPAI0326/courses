from pathlib import Path
import re, hashlib, sys
orig=Path('courses/gen-image/workshop-2h-poster-social.html').read_text()
cand=Path('courses/gen-image/_repair/2026-11-01/workshop-2h-poster-social.candidate.html').read_text()

def one(pattern,s,label):
    m=re.search(pattern,s,re.S)
    if not m:
        print('MISSING',label); sys.exit(1)
    return m.group(0)
checks={}
for label,pat in {
 'head':r'<head>.*?</head>',
 'topbar':r'<header class=\"topbar\">.*?</header>',
 'footer':r'<footer class=\"footer\".*?</footer>',
 'scripts':r'<script>.*?</script>\\s*<script>.*?</script>\\s*<script>.*?</script>',
 'title':r'<h1 class=\"lesson-title\">.*?</h1>',
 'outcomes':r'<div class=\"outcomes\".*?</div>\\s*</div>',
}.items(): checks[label]=one(pat,orig,label)==one(pat,cand,label)
for pid in ['bento','comparison','step','founder','sticker','lookbook']:
    pat=r'<div class=\"prompt-card\" id=\"prompt-workshop-'+pid+r'\">.*?</textarea>\\s*</div>'
    checks['prompt-'+pid]=one(pat,orig,pid)==one(pat,cand,pid)
for fid in ['hierarchy','order','text','typo','colors','series']:
    pat=r'<span id=\"prompt-fix-'+fid+r'\">.*?</span>'
    checks['fix-'+fid]=one(pat,orig,fid)==one(pat,cand,fid)
checks['all-img-tags']=re.findall(r'<img\\b["'^>]*>'"',orig)==re.findall(r'<img\\b["'^>]*>'"',cand)
checks['all-link-tags']=re.findall(r'<a\\b["'^>]*>'"',orig)==re.findall(r'<a\\b["'^>]*>'"',cand)
# timetable first two columns must remain exact
rowpat=r'<tr><td>(.*?)</td><td>(.*?)</td><td>.*?</td></tr>'
ot=one(r'<table class=\"lesson-table\" data-candidate-blocks=\"12\">.*?</table>',orig,'timetable')
ct=one(r'<table class=\"lesson-table\" data-candidate-blocks=\"12\">.*?</table>',cand,'timetable')
checks['timetable-time-stage']=re.findall(rowpat,ot,re.S)==re.findall(rowpat,ct,re.S)
for k,v in checks.items(): print(('PASS' if v else 'FAIL'),k)
if not all(checks.values()): sys.exit(2)
# Remove immutable prompt cards and fix spans for learner prose policy scans.
scan=cand
for pid in ['bento','comparison','step','founder','sticker','lookbook']:
    scan=re.sub(r'<div class=\"prompt-card\" id=\"prompt-workshop-'+pid+r'\">.*?</textarea>\\s*</div>', '', scan, flags=re.S)
scan=re.sub(r'<span id=\"prompt-fix-["'^"]+">.*?</span>'"', '', scan, flags=re.S)
body=scan[scan.index('<div class=\"lesson-body\"'):scan.index('</div><"'!-- /.lesson-body -->'"')]
print('SCAN learner terms')
for term in ['L2','L4','P1','P2','P3','brief','CTA','單一變因','手動完成','有同伴','互看','互換','你是','請扮演']:
    n=body.count(term)
    if n: print(term,n)
print('SCAN restriction markers by section')
for i,sec in enumerate(re.findall(r'<section class=\"lesson-section\">(.*?)</section>', body, re.S),1):
    heading=re.search(r'<h2["'^>]*>(.*?)</h2>'"',sec,re.S).group(1)
    text=re.sub('<["'^>]+>'"',' ',sec)
    hits=[]
    for term in ['不要','不能','禁止','須','嚴禁','不得','不需','不可','不應','不超過']:
        n=text.count(term)
        if n: hits.append(f'{term}={n}')
    print(f'{i:02d}',heading,', '.join(hits) if hits else '0')
# Added classes must be from allowed list; existing classes are exempt.
orig_classes=set(x for a in re.findall(r'class=\"(["'^"]+)"'"',orig) for x in a.split())
cand_classes=set(x for a in re.findall(r'class=\"(["'^"]+)"'"',cand) for x in a.split())
print('NEW_CLASSES',sorted(cand_classes-orig_classes))
