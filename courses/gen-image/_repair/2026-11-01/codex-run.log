<script>
(function(){
  function copyFallback(value){
    var field=document.createElement('textarea');
    field.value=value;
    field.setAttribute('readonly','');
    field.style.position='fixed';
    field.style.left='-9999px';
    document.body.appendChild(field);
    field.select();
    var ok=false;
    try{ok=document.execCommand('copy');}catch(e){}
    field.remove();
    return ok;
  }
  document.querySelectorAll('.prompt-copy-btn').forEach(function(button){
    var originalLabel=button.textContent;
    button.addEventListener('click',async function(){
      var target=document.getElementById(button.dataset.target);
      if(!target)return;
      var value=(target instanceof HTMLTextAreaElement?target.value:target.textContent).trim();
      var ok=false;
      if(navigator.clipboard&&navigator.clipboard.writeText){
        try{await navigator.clipboard.writeText(value);ok=true;}catch(e){}
      }
      if(!ok)ok=copyFallback(value);
      button.textContent=ok?'已複製':'請手動選取';
      button.classList.toggle('copied',ok);
      if(!ok){var range=document.createRange();range.selectNodeContents(target);var selection=window.getSelection();selection.removeAllRanges();selection.addRange(range);}
      clearTimeout(button._resetTimer);
      button._resetTimer=setTimeout(function(){button.textContent=originalLabel;button.classList.remove('copied');},2500);
    });
  });
})();
</script>
