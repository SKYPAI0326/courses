from pathlib import Path
from html.parser import HTMLParser
p=Path('courses/gen-image/_repair/2026-11-01/workshop-2h-poster-social.candidate.html')
class Check(HTMLParser):
    void={'area','base','br','col','embed','hr','img','input','link','meta','param','source','track','wbr'}
    def __init__(self): super().__init__(); self.stack=[]; self.errors=[]
    def handle_starttag(self,tag,attrs):
        if tag not in self.void: self.stack.append(tag)
    def handle_startendtag(self,tag,attrs): pass
    def handle_endtag(self,tag):
        if tag in self.void: return
        if not self.stack: self.errors.append(f'unexpected </{tag}>'); return
        if self.stack[-1]==tag: self.stack.pop(); return
        if tag in self.stack:
            self.errors.append(f'misnested </{tag}> after <{self.stack[-1]}>')
            while self.stack and self.stack[-1]"'!=tag: self.stack.pop()
            if self.stack: self.stack.pop()
        else: self.errors.append(f'"'unmatched </{tag}>')
c=Check(); c.feed(p.read_text()); c.close()
print('HTML_ERRORS',len(c.errors)); print('\\n'.join(c.errors[:20])); print('OPEN_TAGS',c.stack[-20:])
