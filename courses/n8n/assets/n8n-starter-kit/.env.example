# n8n-starter-kit 環境變數範本
# 用法：複製為 .env 並填入自己的值（首次啟動時 start 腳本會自動幫你做）
# Compose 啟動時會自動讀取 .env，再注入到容器

# ---- 時區（影響 Schedule Trigger / Cron 觸發時間） ----
GENERIC_TIMEZONE=Asia/Taipei

# ---- PostgreSQL（n8n 資料庫） ----
# ⚠️ 重要：密碼一旦設定（第一次啟動之後）就不要再改。
# postgres 第一次啟動會把密碼寫進資料庫；之後改 .env 不會自動更新 postgres 內部密碼，
# 會導致 n8n 連 postgres 報「password authentication failed」。
# 真要改密碼，必須先 docker compose -f n8n-compose.yml down -v 清掉 volume（會清資料）。
POSTGRES_USER=n8n
POSTGRES_PASSWORD=please_change_me_to_a_strong_password
POSTGRES_DB=n8n

# ---- Webhook URL ----
# 預設只在本機使用；若日後接反向代理／Tunnel，再依目前版本文件重新驗證：
# N8N_WEBHOOK_URL=https://n8n.your-domain.example.com/
# N8N_HOST=n8n.your-domain.example.com
# N8N_PROTOCOL=https
# N8N_SECURE_COOKIE=true
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_HOST=localhost
N8N_PROTOCOL=http

# ---- Secure Cookie ----
# localhost HTTP 訪問必設 false（n8n 預設要求 HTTPS，不設 false 會擋登入頁）
# 接 Cloudflare Tunnel HTTPS 後改成 true 提升安全
N8N_SECURE_COOKIE=false

# ---- 外部暴露（選配，非本課程 localhost 主線）----
# 對外連線、反向代理、2FA 與額外驗證方式會隨 n8n 版本及部署方式改變。
# 本課程不要求學員開 Tunnel；若要對外，請先依目前版本官方文件完成安全檢查，
# 不要只複製舊教材中的 BASIC_AUTH 變數就直接公開服務。
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=your_username
# N8N_BASIC_AUTH_PASSWORD=replace_with_strong_password

# ---- Gemini API key（Lite Pack v1.3 Code node 透過 $env.GEMINI_API_KEY 讀取） ----
# 用途：n8n-lite-pack 內所有 Gemini workflow 從這條讀 key，避免把真 key 烙進 workflow JSON
# 來源：到 https://aistudio.google.com/apikey 申請（免費）
# 設定方式：setup-wizard 自動寫入此檔，或手動填入後 docker compose restart n8n
# ⚠ 此 .env 千萬不要 commit 到 git（已在課程預設 .gitignore 忽略）
GEMINI_API_KEY=
