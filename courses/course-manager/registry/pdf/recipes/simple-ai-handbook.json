{
  "schema_version": 1,
  "artifact_id": "simple-ai-handbook",
  "course": "simple-ai",
  "output": "output/pdf/simple-ai/創業-AI-實戰手冊.pdf",
  "profile": "course-manager/pdf-profiles/simple-ai.css",
  "sources": [
    {
      "path": "simple-ai/handbook.html",
      "selectors": [
        ".print-book-cover",
        ".print-contents",
        ".print-chapter",
        ".workflow-appendix"
      ],
      "source_url": "https://skypai0326.github.io/courses/courses/simple-ai/handbook.html",
      "static_content_confirmed": true
    }
  ],
  "font_files": [
    "/Library/Fonts/Arial Unicode.ttf"
  ],
  "exclude": [
    {
      "selector": "button.copy-btn,button.prompt-copy-btn,button.step-example-copy,button[data-copy],button[data-policy-copy],button.btn-drill-copy,button.fill-reset,button.fill-copy",
      "reason": "僅供網頁複製原文的按鈕，教材文字保留在原有文字區塊。"
    }
  ],
  "expand": [],
  "dependencies": [],
  "remote_assets": {},
  "notes": "以現行課程首頁或Module頁的實際單元順序對照原PDF範圍；教學正文已存在HTML，scripts為Gate、複製與捲動。",
  "paper_fallbacks": [
    {
      "selector": "textarea[data-slot-input]",
      "mode": "print-source-values",
      "reason": "網頁填寫欄位改為紙本欄位；只列出原HTML已存在的placeholder文字，不填入或推測使用者資料。"
    }
  ]
}