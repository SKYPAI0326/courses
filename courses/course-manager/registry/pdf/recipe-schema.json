{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course PDF recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "course",
    "output",
    "profile",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "course": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "output": {
      "type": "string",
      "pattern": "^output/pdf/[^/]+/[^/]+\\.pdf$"
    },
    "profile": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "selectors",
          "source_url",
          "static_content_confirmed"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "selectors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "source_url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "static_content_confirmed": {
            "const": true
          }
        }
      }
    },
    "font_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude": {
      "$ref": "#/$defs/transforms"
    },
    "expand": {
      "$ref": "#/$defs/transforms"
    },
    "remote_assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "source_courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "paper_fallbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selector",
          "mode",
          "reason"
        ],
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "const": "print-source-values"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "transforms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selector",
          "reason"
        ],
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
