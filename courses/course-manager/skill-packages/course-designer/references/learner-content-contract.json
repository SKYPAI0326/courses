{
  "schema_version": 1,
  "canonical_schema": "contracts/course-lesson-record.schema.json",
  "gate": "G3",
  "author": "course-designer",
  "required_upstream_status": {
    "G0": "PASS",
    "G1": "PASS",
    "G2": "PASS"
  },
  "required_sections": [
    "outcome_ids",
    "criterion_ids",
    "capability_ids",
    "learning_coverage",
    "learner_outcome",
    "context",
    "inputs",
    "deliverable",
    "explanation",
    "full_demonstration",
    "guided_practice",
    "independent_practice",
    "checks",
    "recovery",
    "transfer",
    "asset_references",
    "editorial_evidence"
  ],
  "learning_coverage_fields": [
    "outcome_id",
    "criterion_id",
    "capability_id",
    "teaching_evidence",
    "practice_evidence",
    "assessment_evidence"
  ],
  "aggregate_gate_rule": "G3 validates and passes only one complete record set covering every canonical G2 unit exactly once",
  "coverage_evidence_rule": "teaching, practice, and assessment values are stable IDs of atoms present in the same lesson record",
  "instruction_fields": [
    "purpose",
    "start_state",
    "action",
    "expected_result"
  ],
  "demonstration_fields": [
    "input",
    "rationale",
    "actions",
    "result",
    "verification"
  ],
  "editorial_evidence": {
    "producer": "course-copywriter",
    "required_results": [
      "continuity_passed",
      "learner_readable",
      "internal_labels_removed"
    ],
    "cannot_invent_missing_facts": true
  },
  "prohibited_completion_substitutes": [
    "section_count",
    "word_count",
    "template_field_presence_without_prose_review",
    "author_summary_without_source_hash"
  ],
  "block_when_missing": [
    "complete_demonstration",
    "real_learner_deliverable",
    "recovery_path",
    "asset_reference",
    "editorial_evidence"
  ]
}
