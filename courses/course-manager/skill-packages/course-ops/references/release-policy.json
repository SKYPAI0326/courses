{
  "schema_version": 1,
  "owner": "course-ops",
  "g6_pass_state": "READY_TO_PUBLISH",
  "g6_pass_means_published": false,
  "required_checks": [
    "technical",
    "links",
    "registration",
    "access",
    "rollback",
    "maintenance"
  ],
  "registration_ownership": [
    "password_hash_and_storage_key",
    "gate_registry",
    "course_catalog",
    "course_entry_card",
    "search_index",
    "sitemap"
  ],
  "proposal": {
    "exact_targets": true,
    "before_and_after_sha256": true,
    "verified_backup_required": true,
    "per_target_rollback_required": true,
    "authorization_binds_manifest_sha256": true,
    "single_use_authorization": true
  },
  "apply": {
    "refuse_changed_target": true,
    "refuse_changed_source": true,
    "manifest_targets_only": true,
    "atomic_file_replace": true,
    "rollback_on_failure": true,
    "record_result": true
  },
  "maintenance": {
    "scan_read_only": true,
    "metadata_write_allowed": false,
    "republish_allowed": false,
    "confirmed_drift_routes_to": "course-repair"
  }
}
