{
  "schema_version": 1,
  "external_sources": {
    "required": true,
    "authoritative_current_required": true,
    "technical_primary_sources_required": true,
    "required_fields": [
      "id",
      "title",
      "url",
      "source_type",
      "retrieved_at",
      "version",
      "context"
    ]
  },
  "hands_on": {
    "trigger": {
      "tool_dependency": "high"
    },
    "required": true,
    "required_fields": [
      "id",
      "executed",
      "environment",
      "input",
      "result",
      "failure_notes",
      "limitations"
    ],
    "missing_status": "BLOCKED"
  },
  "preserve_even_when_empty": [
    "conflicts",
    "unknowns",
    "non_conclusions"
  ],
  "failed_hands_on_is_evidence": true,
  "completion": {
    "minimum_source_count": null,
    "criterion": "course_decisions_supported_by_traceable_evidence",
    "ready_gate_status": "PASS",
    "pass_authority": "course-run"
  },
  "output": {
    "record_path": true,
    "sha256": true,
    "adaptation": true,
    "blockers": true,
    "g1_result": [
      "PASS",
      "BLOCKED"
    ]
  }
}
