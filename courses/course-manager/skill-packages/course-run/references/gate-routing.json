{
  "schema_version": 1,
  "support_files": [
    "SKILL.md",
    "references/course-contract-routing.md",
    "references/gate-routing.json"
  ],
  "project_runtime": {
    "working_directory": "courses/course-manager",
    "required_paths": [
      "contracts/course-contract.schema.json",
      "scripts/course_contract.py"
    ]
  },
  "gate_lifecycle_states": [
    "NOT_STARTED",
    "IN_PROGRESS",
    "PASS",
    "FAIL",
    "BLOCKED",
    "STALE"
  ],
  "evidence_maturity_states": [
    "STATIC_VALIDATED",
    "EXECUTION_VALIDATED",
    "INDEPENDENT_AI_VERIFIED",
    "HUMAN_VERIFIED"
  ],
  "gate_status_path": "gates.<gate_id>.status",
  "evidence_maturity_path": "gates.<gate_id>.evidence[].maturity",
  "gate_pass_authority": {
    "role": "course-run",
    "requires_validated_evidence": true,
    "requires_explicit_user_approval": false
  },
  "external_action_authority": {
    "role": "user",
    "requires_explicit_user_approval": true
  },
  "child_authority": {
    "can_return_evidence": true,
    "can_pass_gate": false
  },
  "missing_required_evidence": {
    "gate_status": "BLOCKED",
    "preserve_failure_evidence": true
  },
