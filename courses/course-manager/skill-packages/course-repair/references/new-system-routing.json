{
  "schema_version": 1,
  "entrypoint": "existing_course_repair",
  "inherits_new_course_gate_history": false,
  "workflow": [
    "scan",
    "plan",
    "backup",
    "fix",
    "verify"
  ],
  "mutation_guard": {
    "first_mutating_stage": "fix",
    "backup_required": true,
    "restore_proof_required": true,
    "approved_plan_required": true
  },
  "validator_reuse": {
    "skill": "course-validator",
    "reuse_evidence_formats": true,
    "create_new_course_gate_history": false
  },
  "finding_routes": {
    "source_mismatch": {
      "owner_gate": "G1",
      "revalidation_scope": ["research", "content", "execution"]
    },
    "tool_behavior_mismatch": {
      "owner_gate": "G1",
      "revalidation_scope": ["hands_on", "content", "independent_trial"]
    },
    "sequence_overload": {
      "owner_gate": "G2",
      "revalidation_scope": ["architecture", "content", "sequence"]
    },
    "difficulty_mismatch": {
      "owner_gate": "G2",
      "revalidation_scope": ["architecture", "content", "independent_trial"]
    },
    "explanation_gap": {
      "owner_gate": "G3",
      "revalidation_scope": ["content", "fidelity", "independent_trial"]
    },
    "practice_instruction_gap": {
      "owner_gate": "G3",
      "revalidation_scope": ["content", "fidelity", "independent_trial"]
    },
    "interface_block": {
      "owner_gate": "G4",
      "revalidation_scope": ["render", "accessibility", "independent_trial"]
    },
    "asset_missing": {
      "owner_gate": "G4",
      "revalidation_scope": ["asset", "fidelity", "independent_trial"]
    },
    "full_course_integration": {
      "owner_gate": "G5",
      "revalidation_scope": ["dependencies", "navigation", "full_course_trial"]
    },
    "deployment_failure": {
      "owner_gate": "G6",
      "revalidation_scope": ["release", "rollback"]
    },
    "access_denied": {
      "owner_gate": "G6",
      "revalidation_scope": ["access", "release"]
    }
  },
  "new_course_triggers": {
    "learner_reframe": {
      "owner_gate": "G0",
      "revalidation_scope": ["G0", "G1", "G2", "G3", "G4", "G5", "G6"]
    },
    "outcome_reframe": {
      "owner_gate": "G0",
      "revalidation_scope": ["G0", "G1", "G2", "G3", "G4", "G5", "G6"]
    },
    "whole_course_architecture_reframe": {
      "owner_gate": "G0",
      "revalidation_scope": ["G0", "G1", "G2", "G3", "G4", "G5", "G6"]
    }
  }
}
