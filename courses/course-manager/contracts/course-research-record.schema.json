{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.course-manager/contracts/course-research-record.schema.json",
  "title": "Course Research Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "research_questions", "sources", "claims", "conflicts",
    "unknowns", "representative_task", "hands_on_record", "design_implications",
    "maintenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "research_questions": {"type": "array", "items": {"$ref": "#/$defs/research_question"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
    "representative_task": {"$ref": "#/$defs/representative_task"},
    "hands_on_record": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/hands_on"}]
    },
    "design_implications": {"type": "array", "items": {"$ref": "#/$defs/implication"}},
    "maintenance": {"$ref": "#/$defs/maintenance"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "research_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "decision_use"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "question": {"type": "string", "minLength": 1},
        "decision_use": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "source_type", "retrieved_at", "version", "context"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "source_type": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date"},
        "version": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "source_ids", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "confidence": {"enum": ["low", "medium", "high"]}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim_ids", "description", "handling"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "claim_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "description": {"type": "string", "minLength": 1},
        "handling": {"type": "string", "minLength": 1}
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "impact", "blocking"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "question": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"}
      }
    },
    "representative_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "deliverable", "success_criteria"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "deliverable": {"type": "string", "minLength": 1},
        "success_criteria": {
          "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "hands_on": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "executed", "environment", "input", "result", "failure_notes", "limitations"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "executed": {"type": "boolean"},
        "environment": {"type": "object", "minProperties": 1},
        "input": {"type": "string", "minLength": 1},
        "result": {
          "type": "object",
          "required": ["status"],
          "properties": {"status": {"enum": ["SUCCEEDED", "FAILED"]}},
          "additionalProperties": true
        },
        "failure_notes": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "implication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision", "rationale", "evidence_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "decision": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_due", "owner"],
      "properties": {
        "review_due": {"type": ["string", "null"], "format": "date"},
        "owner": {"type": ["string", "null"]}
      }
    }
  }
}
