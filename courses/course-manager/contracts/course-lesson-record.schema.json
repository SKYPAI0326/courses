{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.course-manager/contracts/course-lesson-record.schema.json",
  "title": "Course Lesson Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "unit_id",
    "learner_outcome",
    "context",
    "inputs",
    "deliverable",
    "explanation",
    "full_demonstration",
    "guided_practice",
    "independent_practice",
    "checks",
    "recovery",
    "transfer",
    "asset_references",
    "editorial_evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "unit_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "learner_outcome": {
      "$ref": "#/$defs/learnerOutcome"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/input" }
    },
    "deliverable": {
      "$ref": "#/$defs/deliverable"
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prose"],
      "properties": {
        "prose": { "$ref": "#/$defs/text" }
      }
    },
    "full_demonstration": {
      "$ref": "#/$defs/demonstration"
    },
    "guided_practice": {
      "$ref": "#/$defs/guidedPractice"
    },
    "independent_practice": {
      "$ref": "#/$defs/independentPractice"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "recovery": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/recovery" }
    },
    "transfer": {
      "$ref": "#/$defs/transfer"
    },
    "asset_references": {
      "$ref": "#/$defs/textList"
    },
    "editorial_evidence": {
      "$ref": "#/$defs/editorialEvidence"
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "textList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/text" }
    },
    "learnerOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidence"],
      "properties": {
        "statement": { "$ref": "#/$defs/text" },
        "evidence": { "$ref": "#/$defs/text" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["situation", "purpose", "prior_result"],
      "properties": {
        "situation": { "$ref": "#/$defs/text" },
        "purpose": { "$ref": "#/$defs/text" },
        "prior_result": { "$ref": "#/$defs/text" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "source", "ready_check"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": { "$ref": "#/$defs/text" },
        "source": { "$ref": "#/$defs/text" },
        "ready_check": { "$ref": "#/$defs/text" }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "format", "use", "acceptance_criteria"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "format": { "$ref": "#/$defs/text" },
        "use": { "$ref": "#/$defs/text" },
        "acceptance_criteria": { "$ref": "#/$defs/textList" }
      }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "start_state", "action", "expected_result"],
      "properties": {
        "purpose": { "$ref": "#/$defs/text" },
        "start_state": { "$ref": "#/$defs/text" },
        "action": { "$ref": "#/$defs/text" },
        "expected_result": { "$ref": "#/$defs/text" }
      }
    },
    "demonstration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "rationale", "actions", "result", "verification"],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "value"],
          "properties": {
            "description": { "$ref": "#/$defs/text" },
            "value": { "$ref": "#/$defs/text" }
          }
        },
        "rationale": { "$ref": "#/$defs/text" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/instruction" }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "artifact_ref"],
          "properties": {
            "description": { "$ref": "#/$defs/text" },
            "artifact_ref": { "$ref": "#/$defs/text" }
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion", "observable_result"],
            "properties": {
              "criterion": { "$ref": "#/$defs/text" },
              "observable_result": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    },
    "guidedPractice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "start_state", "steps", "checks", "recovery_refs"],
      "properties": {
        "purpose": { "$ref": "#/$defs/text" },
        "start_state": { "$ref": "#/$defs/text" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/instruction" }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expected_result", "recovery_ref"],
            "properties": {
              "expected_result": { "$ref": "#/$defs/text" },
              "recovery_ref": { "$ref": "#/$defs/text" }
            }
          }
        },
        "recovery_refs": { "$ref": "#/$defs/textList" }
      }
    },
    "independentPractice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "changed_conditions",
        "decision_required",
        "deliverable",
        "acceptance_criteria",
        "verification"
      ],
      "properties": {
        "context": { "$ref": "#/$defs/text" },
        "changed_conditions": { "$ref": "#/$defs/textList" },
        "decision_required": { "$ref": "#/$defs/text" },
        "deliverable": { "$ref": "#/$defs/text" },
        "acceptance_criteria": { "$ref": "#/$defs/textList" },
        "verification": { "$ref": "#/$defs/text" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "expected_result", "on_failure"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "target": { "$ref": "#/$defs/text" },
        "expected_result": { "$ref": "#/$defs/text" },
        "on_failure": { "$ref": "#/$defs/text" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "symptom", "cause", "action", "expected_result"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "symptom": { "$ref": "#/$defs/text" },
        "cause": { "$ref": "#/$defs/text" },
        "action": { "$ref": "#/$defs/text" },
        "expected_result": { "$ref": "#/$defs/text" }
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new_context", "method", "limits"],
      "properties": {
        "new_context": { "$ref": "#/$defs/text" },
        "method": { "$ref": "#/$defs/text" },
        "limits": { "$ref": "#/$defs/text" }
      }
    },
    "editorialEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "source_sha256",
        "continuity_passed",
        "learner_readable",
        "internal_labels_removed",
        "notes"
      ],
      "properties": {
        "reviewer_id": { "$ref": "#/$defs/text" },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "continuity_passed": { "const": true },
        "learner_readable": { "const": true },
        "internal_labels_removed": { "const": true },
        "notes": { "$ref": "#/$defs/text" }
      }
    }
  }
}
