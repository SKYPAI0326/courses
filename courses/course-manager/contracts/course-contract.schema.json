{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.course-manager/contracts/course-contract.schema.json",
  "title": "Course Design Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "governance",
    "gates",
    "G0_requirements",
    "G1_research",
    "adaptation",
    "G2_architecture",
    "G3_lesson_design",
    "G4_pilot",
    "G5_production",
    "G6_release_maintenance",
    "changes",
    "evidence_index"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "title"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_by",
        "created_at",
        "approval_authority"
      ],
      "properties": {
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "approval_authority": {
          "const": "course-run-with-explicit-user-approval"
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6"
      ],
      "properties": {
        "G0": {
          "$ref": "#/$defs/gate"
        },
        "G1": {
          "$ref": "#/$defs/gate"
        },
        "G2": {
          "$ref": "#/$defs/gate"
        },
        "G3": {
          "$ref": "#/$defs/gate"
        },
        "G4": {
          "$ref": "#/$defs/gate"
        },
        "G5": {
          "$ref": "#/$defs/gate"
        },
        "G6": {
          "$ref": "#/$defs/gate"
        }
      }
    },
    "G0_requirements": {
      "type": "object",
      "additionalProperties": true
    },
    "G1_research": {
      "type": "object",
      "additionalProperties": true
    },
    "adaptation": {
      "type": "object",
      "additionalProperties": true
    },
    "G2_architecture": {
      "type": "object",
      "additionalProperties": true
    },
    "G3_lesson_design": {
      "type": "object",
      "additionalProperties": true
    },
    "G4_pilot": {
      "type": "object",
      "additionalProperties": true
    },
    "G5_production": {
      "type": "object",
      "additionalProperties": true
    },
    "G6_release_maintenance": {
      "type": "object",
      "additionalProperties": true
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_index": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "owner",
        "inputs",
        "deliverables",
        "evidence",
        "risks",
        "open_questions",
        "approved_by",
        "approved_at",
        "source_revision",
        "affected_downstream"
      ],
      "properties": {
        "status": {
          "enum": [
            "DRAFT",
            "REVIEW",
            "APPROVED",
            "BLOCKED",
            "STALE"
          ]
        },
        "owner": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_revision": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "affected_downstream": {
          "type": "array",
          "items": {
            "enum": [
              "G0",
              "G1",
              "G2",
              "G3",
              "G4",
              "G5",
              "G6"
            ]
          }
        }
      }
    }
  }
}
