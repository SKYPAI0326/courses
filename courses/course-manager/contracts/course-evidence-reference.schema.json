{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.course-manager/contracts/course-evidence-reference.schema.json",
  "title": "Course Evidence Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "gate", "kind", "path", "sha256"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "gate": { "enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6"] },
    "kind": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)(?!\\.(?:/+\\.?)*$)(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "maturity": { "enum": ["STATIC_VALIDATED", "EXECUTION_VALIDATED", "INDEPENDENT_AI_VERIFIED", "PENDING_HUMAN", "HUMAN_VERIFIED", "AUTHORITY_SIGNED"] },
    "metadata": { "type": "object" }
  }
}
